@inherits LayoutComponentBase

<div class="pf-shell">

    <input type="checkbox" id="pf-menu" class="pf-menu-toggle" aria-label="Mostrar menú" />

    <aside class="pf-sidebar">
        <NavMenu />
    </aside>

    <label for="pf-menu" class="pf-menu-fondo" aria-hidden="true"></label>

    <div class="pf-main-area">

        <header class="pf-topbar">
            <label for="pf-menu" class="pf-menu-boton" title="Menú"></label>
        </header>

        <main class="pf-page-content">
            @Body
        </main>

    </div>

</div>