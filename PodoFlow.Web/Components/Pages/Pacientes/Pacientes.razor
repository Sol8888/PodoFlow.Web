@page "/pacientes"
@rendermode InteractiveServer

@using PodoFlow.Web.Modelos.Pacientes
@using PodoFlow.Web.Servicios

@inject IPacientesApi Api

<PageTitle>Pacientes | PodoFlow</PageTitle>

<div class="pf-pacientes">

    <!-- ENCABEZADO DEL MÓDULO -->

    <div class="pf-module-header">
        <div>
            <span class="pf-module-eyebrow">
                GESTIÓN CLÍNICA
            </span>

            <h1>Pacientes</h1>

            <p>
                Administra la información de los pacientes
                del Centro Podológico TODO PIE.
            </p>
        </div>

        <a href="/pacientes/nuevo"
           class="pf-btn pf-btn-main">
            + Nuevo paciente
        </a>
    </div>

    <!-- HERRAMIENTAS DEL DIRECTORIO -->

    <div class="pf-module-toolbar">

        <input type="search"
               class="pf-field pf-search-field"
               placeholder="Buscar en esta página por nombre o identificación..."
               aria-label="Buscar pacientes en la página actual"
               @bind="Busqueda"
               @bind:event="oninput" />

        <label class="pf-checkbox">
            <input type="checkbox"
                   @bind="IncluirInactivos"
                   @bind:after="RecargarAsync"
                   disabled="@Cargando" />

            Incluir inactivos
        </label>

        <button type="button"
                class="pf-btn"
                disabled="@Cargando"
                @onclick="ActualizarAsync">
            @(Cargando ? "Actualizando..." : "Actualizar")
        </button>

    </div>

    <!-- DIRECTORIO DE PACIENTES -->

    <section class="pf-card pf-directory">

        <div class="pf-card-header">
            <div>
                <h2>Directorio de pacientes</h2>

                <p>
                    Consulta la información y selecciona
                    un paciente para abrir su ficha.
                </p>
            </div>

            <span class="pf-soft-chip">
                @Filtrados.Count visibles
            </span>
        </div>

        @if (Cargando)
        {
            <div class="pf-empty" role="status">
                <p>Cargando pacientes...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="pf-empty" role="alert">
                <h3>No se pudo cargar el directorio</h3>

                <p>@Error</p>

                <button type="button"
                        class="pf-btn"
                        @onclick="ActualizarAsync">
                    Reintentar
                </button>
            </div>
        }
        else if (ListaPacientes.Count == 0)
        {
            <div class="pf-empty">
                <h3>No hay pacientes para mostrar</h3>

                <p>
                    No hay pacientes disponibles
                    con los filtros seleccionados.
                </p>

                @if (!IncluirInactivos)
                {
                    <p>
                        Prueba activando la opción
                        "Incluir inactivos".
                    </p>
                }

                <a href="/pacientes/nuevo"
                   class="pf-btn pf-btn-main">
                    + Registrar paciente
                </a>
            </div>
        }
        else if (Filtrados.Count == 0)
        {
            <div class="pf-empty">
                <h3>Sin coincidencias</h3>

                <p>
                    No se encontraron coincidencias
                    con "@Busqueda" en esta página.
                </p>

                <button type="button"
                        class="pf-btn"
                        @onclick="LimpiarBusqueda">
                    Limpiar búsqueda
                </button>
            </div>
        }
        else
        {
            <div class="pf-table-wrap">
                <table class="pf-table">

                    <thead>
                        <tr>
                            <th>Paciente</th>
                            <th>Identificación</th>
                            <th>Estado</th>
                            <th>Fecha de registro</th>
                            <th>Acción</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var paciente in Filtrados)
                        {
                            <tr @key="paciente.Id">

                                <td>
                                    <div class="pf-patient">

                                        <div class="pf-patient-avatar">
                                            @Iniciales(paciente)
                                        </div>

                                        <strong>
                                            @paciente.NombreCompleto
                                        </strong>

                                    </div>
                                </td>

                                <td>
                                    @paciente.TipoIdentificacion
                                    · @paciente.Identificacion
                                </td>

                                <td>
                                    <span class="pf-status @(paciente.Estatus ? "success" : "danger")">
                                        @(paciente.Estatus ? "ACTIVO" : "INACTIVO")
                                    </span>
                                </td>

                                <td>
                                    @FormatearFecha(paciente.FechaCreacion)
                                </td>

                                <td>
                                    <a class="pf-action-link"
                                       href="@($"/pacientes/{paciente.Id}")">
                                        Ver ficha →
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </section>

    <!-- PAGINACIÓN -->
    @if (!Cargando &&
             string.IsNullOrWhiteSpace(Error) &&
             (Pagina > 1 || ListaPacientes.Count > 0))
    {
        <div class="pf-pagination">

            <button type="button"
                    disabled="@(Pagina <= 1)"
                    @onclick="AnteriorAsync">
                Anterior
            </button>

            <span>
                Página @Pagina
            </span>

            <button type="button"
                    disabled="@(!PuedeAvanzar)"
                    @onclick="SiguienteAsync">
                Siguiente
            </button>

        </div>
    }

</div>

@code {

    // ============================================
    // ESTADO DEL COMPONENTE
    // ============================================

    private List<PacienteDto> ListaPacientes = new();

    private bool Cargando = true;

    private bool IncluirInactivos;

    private bool PuedeAvanzar;

    private string Busqueda = "";

    private string? Error;

    private int Pagina = 1;

    private const int Tamano = 10;

    // ============================================
    // FILTRO DE BÚSQUEDA LOCAL
    // ============================================

    private List<PacienteDto> Filtrados =>
        ListaPacientes
            .Where(CoincideBusqueda)
            .ToList();

    private bool CoincideBusqueda(PacienteDto paciente)
    {
        if (string.IsNullOrWhiteSpace(Busqueda))
            return true;

        string texto = Busqueda.Trim();

        return (paciente.NombreCompleto ?? "")
                   .Contains(texto, StringComparison.OrdinalIgnoreCase)
            || (paciente.Identificacion ?? "")
                   .Contains(texto, StringComparison.OrdinalIgnoreCase)
            || (paciente.Nombres ?? "")
                   .Contains(texto, StringComparison.OrdinalIgnoreCase)
            || (paciente.Apellidos ?? "")
                   .Contains(texto, StringComparison.OrdinalIgnoreCase);
    }

    // ============================================
    // INICIALIZACIÓN
    // ============================================

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    // ============================================
    // CARGAR DIRECTORIO
    // ============================================

    private async Task CargarAsync()
    {
        Cargando = true;
        Error = null;

        try
        {
            var pacientes = await Api.ListarAsync(
                IncluirInactivos,
                Pagina,
                Tamano);

            ListaPacientes = pacientes;

            PuedeAvanzar = ListaPacientes.Count == Tamano;
        }
        catch (InvalidOperationException ex)
        {
            Error = ex.Message;

            ListaPacientes.Clear();

            PuedeAvanzar = false;
        }
        catch (HttpRequestException)
        {
            Error =
                "No fue posible conectar con PodoFlow.Api. " +
                "Verifica que el backend esté ejecutándose.";

            ListaPacientes.Clear();

            PuedeAvanzar = false;
        }
        catch (Exception)
        {
            Error =
                "Ocurrió un error al cargar el directorio. " +
                "Intenta nuevamente.";

            ListaPacientes.Clear();

            PuedeAvanzar = false;
        }
        finally
        {
            Cargando = false;
        }
    }

    // ============================================
    // ACTUALIZAR
    // ============================================

    private async Task ActualizarAsync()
    {
        if (Cargando)
            return;

        await CargarAsync();
    }

    // ============================================
    // CAMBIAR FILTRO
    // ============================================

    private async Task RecargarAsync()
    {
        Pagina = 1;

        Busqueda = "";

        await CargarAsync();
    }

    // ============================================
    // LIMPIAR BÚSQUEDA
    // ============================================

    private void LimpiarBusqueda()
    {
        Busqueda = "";
    }

    // ============================================
    // PAGINACIÓN ANTERIOR
    // ============================================

    private async Task AnteriorAsync()
    {
        if (Cargando || Pagina <= 1)
            return;

        Pagina--;

        await CargarAsync();
    }

    // ============================================
    // PAGINACIÓN SIGUIENTE
    // ============================================

    private async Task SiguienteAsync()
    {
        if (Cargando || !PuedeAvanzar)
            return;

        int paginaAnterior = Pagina;

        Pagina++;

        await CargarAsync();

        if (string.IsNullOrWhiteSpace(Error) &&
            ListaPacientes.Count == 0)
        {
            Pagina = paginaAnterior;

            await CargarAsync();

            PuedeAvanzar = false;
        }
    }

    // ============================================
    // INICIALES DEL PACIENTE
    // ============================================

    private static string Iniciales(PacienteDto paciente)
    {
        char inicialNombre =
            string.IsNullOrWhiteSpace(paciente.Nombres)
                ? '?'
                : paciente.Nombres.Trim()[0];

        char inicialApellido =
            string.IsNullOrWhiteSpace(paciente.Apellidos)
                ? ' '
                : paciente.Apellidos.Trim()[0];

        return $"{inicialNombre}{inicialApellido}"
            .Trim()
            .ToUpperInvariant();
    }

    // ============================================
    // FORMATO DE FECHAS
    // ============================================

    private static string FormatearFecha(DateTime fecha)
    {
        return fecha == default
            ? "Sin fecha"
            : fecha.ToString("dd/MM/yyyy");
    }
}
