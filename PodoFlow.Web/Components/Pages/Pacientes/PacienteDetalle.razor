                Id);

            ErrorEstado =
                "No fue posible reactivar el paciente.";
        }
        finally
        {
            ProcesandoEstado = false;
        }
    }

    private void CancelarCambioEstado()
    {
        ConfirmandoDesactivacion = false;
        ConfirmandoReactivacion = false;
        MotivoDesactivacion = "";
    }

    // ============================================
    // CREAR Y EDITAR CONTACTO
    // ============================================

    private async Task GuardarContactoAsync()
    {
        if (GuardandoContacto || Paciente?.Estatus != true)
            return;

        GuardandoContacto = true;

        ErrorContactos = null;
        MensajeContacto = null;

        try
        {
            if (ContactoEditandoId.HasValue)
            {
                await Api.ActualizarContactoAsync(
                    ContactoEditandoId.Value,
                    FormularioContacto);

                MensajeContacto = "Contacto actualizado correctamente.";
            }
            else
            {
                await Api.CrearContactoAsync(
                    Id,
                    FormularioContacto);

                MensajeContacto = "Contacto agregado correctamente.";
            }

            CancelarEdicionContacto();

            await CargarContactosAsync();
        }
        catch (InvalidOperationException ex)
        {
            ErrorContactos = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error guardando contacto del paciente {PacienteId}",
                Id);

            ErrorContactos =
                "No fue posible guardar el contacto.";
        }
        finally
        {
            GuardandoContacto = false;
        }
    }

    private void EditarContacto(ContactoPacienteDto contacto)
    {
        if (Paciente?.Estatus != true || !contacto.Estatus)
            return;

        ContactoEditandoId = contacto.Id;

        FormularioContacto = new ContactoGuardarDto
        {
            Tipo = contacto.Tipo,
            Valor = contacto.Valor,
            Principal = contacto.Principal
        };

        MensajeContacto = null;
        ErrorContactos = null;
    }

    private void CancelarEdicionContacto()
    {
        ContactoEditandoId = null;
        FormularioContacto = new ContactoGuardarDto();
    }

    // ============================================
    // ESTADO DE CONTACTOS
    // ============================================

    private void SolicitarCambioContacto(ContactoPacienteDto contacto)
    {
        ContactoConfirmacionId = contacto.Id;
        ErrorContactos = null;
        MensajeContacto = null;
    }

    private void CancelarCambioContacto()
    {
        ContactoConfirmacionId = null;
    }

    private async Task CambiarEstadoContactoAsync(
        ContactoPacienteDto contacto)
    {
        if (ProcesandoContacto ||
            Paciente?.Estatus != true ||
            ContactoConfirmacionId != contacto.Id)
            return;

        ProcesandoContacto = true;
        ErrorContactos = null;
        MensajeContacto = null;

        try
        {
            if (contacto.Estatus)
            {
                await Api.DesactivarContactoAsync(contacto.Id);
                MensajeContacto = "Contacto desactivado correctamente.";
            }
            else
            {
                await Api.ReactivarContactoAsync(contacto.Id);
                MensajeContacto = "Contacto reactivado correctamente.";
            }

            CancelarCambioContacto();

            await CargarContactosAsync();
        }
        catch (InvalidOperationException ex)
        {
            ErrorContactos = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error cambiando estado del contacto {ContactoId}",
                contacto.Id);

            ErrorContactos =
                "No se pudo cambiar el estado del contacto.";
        }
        finally
        {
            ProcesandoContacto = false;
        }
    }

    // ============================================
    // UTILIDADES
    // ============================================

    private static string MostrarValor(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? "No registrado"
            : valor;
    }

    private static string FormatearFecha(DateTime fecha)
    {
        return fecha == default
            ? "No registrada"
            : fecha.ToString("dd/MM/yyyy");
    }

    private static string ClaseEstado(string? estado)
    {
        return (estado ?? "").ToUpperInvariant() switch
        {
            "CONFIRMADA" or "PAGADA" or "ATENDIDA" => "success",
            "PENDIENTE" or "PROGRAMADA" => "warning",
            "CANCELADA" or "ANULADA" => "danger",
            _ => "info"
        };
    }
