    // ============================================
    // DESACTIVAR PACIENTE
    // ============================================

    private void MostrarDesactivacion()
    {
        ConfirmandoDesactivacion = true;
        ConfirmandoReactivacion = false;

        MotivoDesactivacion = "";
        ErrorEstado = null;
        MensajeEstado = null;
    }

    private async Task DesactivarPacienteAsync()
    {
        if (ProcesandoEstado ||
            Paciente?.Estatus != true ||
            !ConfirmandoDesactivacion)
            return;

        if (string.IsNullOrWhiteSpace(MotivoDesactivacion))
        {
            ErrorEstado = "Debes ingresar un motivo.";
            return;
        }

        ProcesandoEstado = true;
        ErrorEstado = null;

        try
        {
            await Api.DesactivarAsync(
                Id,
                MotivoDesactivacion.Trim());

            await CargarPacienteAsync();

            if (Paciente?.Estatus == false)
                MensajeEstado = "Paciente desactivado correctamente.";
        }
        catch (InvalidOperationException ex)
        {
            ErrorEstado = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error desactivando paciente {PacienteId}",
                Id);

            ErrorEstado =
                "No fue posible desactivar el paciente.";
        }
        finally
        {
            ProcesandoEstado = false;
        }
    }

    // ============================================
    // REACTIVAR PACIENTE
    // ============================================

    private void MostrarReactivacion()
    {
        ConfirmandoReactivacion = true;
        ConfirmandoDesactivacion = false;

        ErrorEstado = null;
        MensajeEstado = null;
    }

    private async Task ReactivarPacienteAsync()
    {
        if (ProcesandoEstado ||
            Paciente?.Estatus != false ||
            !ConfirmandoReactivacion)
            return;

        ProcesandoEstado = true;
        ErrorEstado = null;

        try
        {
            await Api.ReactivarAsync(Id);

            await CargarPacienteAsync();

            if (Paciente?.Estatus == true)
                MensajeEstado = "Paciente reactivado correctamente.";
        }
        catch (InvalidOperationException ex)
        {
            ErrorEstado = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(
