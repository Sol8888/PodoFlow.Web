@page "/pacientes/{Id:long}"
@rendermode InteractiveServer

@using PodoFlow.Web.Modelos.Pacientes
@using PodoFlow.Web.Servicios

@inject IPacientesApi Api
@inject ILogger<PacienteDetalle> Logger

<PageTitle>Ficha del paciente | PodoFlow</PageTitle>

<div class="pf-pacientes">

    <a href="/pacientes" class="pf-back-link">
        ← Volver al directorio
    </a>

    @if (Cargando)
    {
        <section class="pf-card pf-info-card">
            <div class="pf-empty" role="status">
                Cargando información del paciente...
            </div>
        </section>
    }
    else if (Paciente is null)
    {
        <section class="pf-card pf-info-card">
            <h2>No se pudo abrir la ficha</h2>

            <p class="pf-detail-error" role="alert">
                @(ErrorPaciente ?? "El paciente no existe.")
            </p>

            <button type="button"
                    class="pf-btn pf-btn-neutral"
                    @onclick="RecargarPacienteAsync">
                Reintentar
            </button>

            <a href="/pacientes" class="pf-back-link">
                Volver al directorio
            </a>
        </section>
    }
    else
    {
        <section class="pf-profile-hero">

            <div class="pf-profile-avatar">
                @Iniciales
            </div>

            <div class="pf-profile-info">

                <span class="pf-profile-label">
                    EXPEDIENTE DEL PACIENTE · #@Paciente.Id
                </span>

                <h1>@Paciente.NombreCompleto</h1>

                <div class="pf-profile-meta">

                    <span>
                        @Paciente.TipoIdentificacion ·
                        @Paciente.Identificacion
                    </span>

                    <span class="pf-profile-state">
                        @(Paciente.Estatus ? "Activo" : "Inactivo")
                    </span>

                </div>
            </div>

            <div class="pf-profile-actions">

                <a class="pf-profile-button"
                   href="@($"/privacidad/consentimientos?pacienteId={Id}")">
                    Gestionar consentimientos
                </a>

                @if (Paciente.Estatus)
                {
                    <a class="pf-profile-button"
                       href="@($"/pacientes/{Id}/editar")">
                        Editar paciente
                    </a>

                    <button type="button"
                            class="pf-profile-button"
                            disabled="@ProcesandoEstado"
                            @onclick="MostrarDesactivacion">
                        Desactivar
                    </button>
                }
                else
                {
                    <button type="button"
                            class="pf-profile-button"
                            disabled="@ProcesandoEstado"
                            @onclick="MostrarReactivacion">
                        Reactivar paciente
                    </button>
                }

            </div>

        </section>

        @if (!string.IsNullOrWhiteSpace(ErrorEstado))
        {
            <div class="pf-detail-error" role="alert">
                @ErrorEstado
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(MensajeEstado))
        {
            <div class="pf-contact-success" role="status">
                @MensajeEstado
            </div>
        }

        @if (ConfirmandoDesactivacion)
        {
            <section class="pf-card pf-info-card">

                <h2>Desactivar paciente</h2>

                <p class="pf-detail-muted">
                    El paciente dejará de estar activo en el sistema.
                    Su información no será eliminada físicamente.
                </p>

                <div class="pf-form-group">
                    <label for="motivoDesactivacion">
                        Motivo de desactivación *
                    </label>

                    <textarea id="motivoDesactivacion"
                              class="pf-field"
                              rows="3"
                              maxlength="300"
                              @bind="MotivoDesactivacion"
                              @bind:event="oninput">
                    </textarea>
                </div>

                <div class="pf-form-actions">

                    <button type="button"
                            class="pf-btn pf-btn-neutral"
                            disabled="@ProcesandoEstado"
                            @onclick="CancelarCambioEstado">
                        Cancelar
                    </button>

                    <button type="button"
                            class="pf-btn pf-btn-main"
                            disabled="@(ProcesandoEstado ||
                                                                    string.IsNullOrWhiteSpace(MotivoDesactivacion))"
                            @onclick="DesactivarPacienteAsync">
                        @(ProcesandoEstado
                            ? "Procesando..."
                            : "Confirmar desactivación")
                    </button>

                </div>

            </section>
        }

        @if (ConfirmandoReactivacion)
        {
            <section class="pf-card pf-info-card">

                <h2>Reactivar paciente</h2>

                <p class="pf-detail-muted">
                    ¿Deseas reactivar este paciente?
                    Volverá a estar disponible para las
                    operaciones autorizadas del sistema.
                </p>

                <div class="pf-form-actions">

                    <button type="button"
                            class="pf-btn pf-btn-neutral"
                            disabled="@ProcesandoEstado"
                            @onclick="CancelarCambioEstado">
                        Cancelar
                    </button>

                    <button type="button"
                            class="pf-btn pf-btn-main"
                            disabled="@ProcesandoEstado"
                            @onclick="ReactivarPacienteAsync">
                        @(ProcesandoEstado
                            ? "Procesando..."
                            : "Confirmar reactivación")
                    </button>

                </div>

            </section>
        }

        <nav class="pf-profile-tabs"
             aria-label="Información del paciente">

            <a href="@Ruta("resumen")"
               class="@ClasePestana("resumen")">
                Resumen
            </a>

            <a href="@Ruta("contactos")"
               class="@ClasePestana("contactos")">
                Contactos
            </a>

            <a href="@Ruta("citas")"
               class="@ClasePestana("citas")">
                Citas
            </a>

            <a href="@Ruta("historia")"
               class="@ClasePestana("historia")">
                Historia clínica
            </a>

            <a href="@Ruta("pagos")"
               class="@ClasePestana("pagos")">
                Pagos
            </a>

        </nav>

        @if (SeccionActual == "resumen")
        {
            <div class="pf-detail-grid">

                <section class="pf-card pf-info-card">

                    <h2>Información personal</h2>

                    <div class="pf-data-row">
                        <span>Nombres</span>
                        <strong>@Paciente.Nombres</strong>
                    </div>

                    <div class="pf-data-row">
                        <span>Apellidos</span>
                        <strong>@Paciente.Apellidos</strong>
                    </div>

                    <div class="pf-data-row">
                        <span>Tipo de identificación</span>
                        <strong>@Paciente.TipoIdentificacion</strong>
                    </div>

                    <div class="pf-data-row">
                        <span>Identificación</span>
                        <strong>@Paciente.Identificacion</strong>
                    </div>

                    <div class="pf-data-row">
                        <span>Fecha de nacimiento</span>
                        <strong>
                            @(Paciente.FechaNacimiento?.ToString("dd/MM/yyyy")
                                ?? "No registrada")
                        </strong>
                    </div>

                    <div class="pf-data-row">
                        <span>Género</span>
                        <strong>
                            @MostrarValor(Paciente.Genero)
                        </strong>
                    </div>

                    <div class="pf-data-row">
                        <span>Dirección</span>
                        <strong>
                            @MostrarValor(Paciente.Direccion)
                        </strong>
                    </div>

                    <div class="pf-data-row">
                        <span>Fecha de registro</span>
                        <strong>
                            @FormatearFecha(Paciente.FechaCreacion)
                        </strong>
                    </div>

                    <div class="pf-data-row">
                        <span>Última modificación</span>
                        <strong>
                            @(Paciente.FechaModificacion?.ToString("dd/MM/yyyy")
                                ?? "Sin modificaciones registradas")
                        </strong>
                    </div>

                </section>

                <section class="pf-card pf-info-card">

                    <div class="pf-last-activity-heading">

                        <span class="pf-last-activity-icon">+</span>

                        <div>
                            <h2>Última actividad</h2>

                            <p>
                                Información reciente del paciente,
                                disponible de un vistazo.
                            </p>
                        </div>

                    </div>

                    <div class="pf-last-activity-item">

                        <div class="pf-last-activity-top">
                            <span>Última cita registrada</span>
                            <span class="pf-last-activity-indicator"></span>
                        </div>

                        @if (CargandoCitas)
                        {
                            <strong>Cargando citas...</strong>
                        }
                        else if (ErrorCitas is not null)
                        {
                            <p class="pf-detail-error">
                                @ErrorCitas
                            </p>
                        }
                        else if (UltimaCita is null)
                        {
                            <strong>Sin citas registradas</strong>

                            <small>
                                No hay citas disponibles para este paciente.
                            </small>
                        }
                        else
                        {
                            <strong>
                                @UltimaCita.FechaInicio.ToString("dd/MM/yyyy")
                            </strong>

                            <small>
                                @UltimaCita.FechaInicio.ToString("HH:mm")
                                · Estado: @UltimaCita.Estado
                            </small>
                        }

                    </div>

                    <div class="pf-last-activity-item">

                        <div class="pf-last-activity-top">
                            <span>Última atención clínica</span>
                            <span class="pf-last-activity-indicator orange"></span>
                        </div>

                        <strong>Pendiente de integración</strong>

                        <small>
                            Esta información se conectará con
                            el módulo de historial clínico.
                        </small>

                    </div>

                    <div class="pf-last-activity-footer">
                        La información clínica deberá consultarse
                        únicamente con autorización.
                    </div>

                </section>

            </div>
        }
        else if (SeccionActual == "contactos")
        {
            <section class="pf-card pf-info-card">

                <div class="pf-detail-heading">
                    <div>
                        <h2>Datos de contacto</h2>

                        <p class="pf-detail-muted">
                            Administra teléfonos, correos y otros contactos.
                        </p>
                    </div>

                    <button type="button"
                            class="pf-btn pf-btn-neutral"
                            disabled="@CargandoContactos"
                            @onclick="CargarContactosAsync">
                        Actualizar
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorContactos))
                {
                    <p class="pf-detail-error" role="alert">
                        @ErrorContactos
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(MensajeContacto))
                {
                    <p class="pf-contact-success" role="status">
                        @MensajeContacto
                    </p>
                }
                @if (CargandoContactos)
                {
                    <div class="pf-detail-empty">
                        Cargando contactos...
                    </div>
                }
                else if (Contactos.Count == 0)
                {
                    <div class="pf-detail-empty">
                        No hay contactos registrados.
                    </div>
                }
                else
                {
                    @foreach (var contacto in Contactos)
                    {
                        <div class="pf-contact-entry" @key="contacto.Id">

                            <div>
                                <strong>@contacto.Valor</strong>

                                <span>
                                    @contacto.Tipo
                                    @(contacto.Principal ? " · Principal" : "")
                                    · @(contacto.Estatus ? "Activo" : "Inactivo")
                                </span>
                            </div>

                            @if (Paciente.Estatus)
                            {
                                <div class="pf-contact-buttons">

                                    @if (contacto.Estatus)
                                    {
                                        <button type="button"
                                                class="pf-contact-action"
                                                disabled="@ProcesandoContacto"
                                                @onclick="() => EditarContacto(contacto)">
                                            Editar
                                        </button>
                                    }

                                    <button type="button"
                                            class="pf-contact-action"
                                            disabled="@ProcesandoContacto"
                                            @onclick="() => SolicitarCambioContacto(contacto)">
                                        @(contacto.Estatus
                                            ? "Desactivar"
                                            : "Reactivar")
                                    </button>

                                </div>
                            }

                            @if (ContactoConfirmacionId == contacto.Id)
                            {
                                <div class="pf-contact-editor">

                                    <p>
                                        ¿Confirmas que deseas
                                        @(contacto.Estatus
                                            ? "desactivar"
                                            : "reactivar")
                                        este contacto?
                                    </p>

                                    <div class="pf-contact-buttons">

                                        <button type="button"
                                                class="pf-btn pf-btn-neutral"
                                                disabled="@ProcesandoContacto"
                                                @onclick="CancelarCambioContacto">
                                            Cancelar
                                        </button>

                                        <button type="button"
                                                class="pf-btn pf-btn-main"
                                                disabled="@ProcesandoContacto"
                                                @onclick="() => CambiarEstadoContactoAsync(contacto)">
                                            Confirmar
                                        </button>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                }
                @if (Paciente.Estatus)
                {
                    <div class="pf-contact-editor">

                        <h3>
                            @(ContactoEditandoId.HasValue
                                ? "Editar contacto"
                                : "Agregar contacto")
                        </h3>

                        <EditForm @key="ContactoEditandoId"
                                  Model="@FormularioContacto"
                                  OnValidSubmit="@GuardarContactoAsync"
                                  FormName="form-contacto">

                            <DataAnnotationsValidator />

                            <div class="pf-contact-fields">

                                <div>
                                    <label>Tipo de contacto</label>

                                    <InputSelect class="pf-field"
                                                 @bind-Value="FormularioContacto.Tipo"
                                                 disabled="@GuardandoContacto">

                                        <option value="TELEFONO">Teléfono</option>
                                        <option value="CELULAR">Celular</option>
                                        <option value="CORREO">Correo electrónico</option>
                                        <option value="WHATSAPP">WhatsApp</option>
                                        <option value="OTRO">Otro</option>

                                    </InputSelect>

                                    <ValidationMessage For="@(() => FormularioContacto.Tipo)" />
                                </div>

                                <div>
                                    <label>Contacto</label>

                                    <InputText class="pf-field"
                                               maxlength="320"
                                               placeholder="Ingresa el contacto"
                                               @bind-Value="FormularioContacto.Valor"
                                               disabled="@GuardandoContacto" />

                                    <ValidationMessage For="@(() => FormularioContacto.Valor)" />
                                </div>

                                <label class="pf-contact-check">
                                    <InputCheckbox @bind-Value="FormularioContacto.Principal"
                                                   disabled="@GuardandoContacto" />
                                    Principal
                                </label>

                            </div>

                            <div class="pf-contact-buttons">

                                @if (ContactoEditandoId.HasValue)
                                {
                                    <button type="button"
                                            class="pf-btn pf-btn-neutral"
                                            disabled="@GuardandoContacto"
                                            @onclick="CancelarEdicionContacto">
                                        Cancelar
                                    </button>
                                }

                                <button type="submit"
                                        class="pf-btn pf-btn-main"
                                        disabled="@GuardandoContacto">
                                    @(GuardandoContacto
                                        ? "Guardando..."
                                        : ContactoEditandoId.HasValue
                                            ? "Guardar cambios"
                                            : "Agregar contacto")
                                </button>

                            </div>

                        </EditForm>

                    </div>
                }

            </section>
        }
        else if (SeccionActual == "citas")
        {
            <section class="pf-card pf-info-card">

                <div class="pf-detail-heading">
                    <div>
                        <h2>Citas del paciente</h2>

                        <p class="pf-detail-muted">
                            Historial de citas y próximas visitas.
                        </p>
                    </div>

                    <button type="button"
                            class="pf-btn pf-btn-neutral"
                            disabled="@CargandoCitas"
                            @onclick="CargarCitasAsync">
                        Actualizar
                    </button>
                </div>

                @if (CargandoCitas)
                {
                    <div class="pf-detail-empty">
                        Cargando citas...
                    </div>
                }
                else if (ErrorCitas is not null)
                {
                    <p class="pf-detail-error">@ErrorCitas</p>
                }
                else if (Citas.Count == 0)
                {
                    <div class="pf-detail-empty">
                        No hay citas registradas para este paciente.
                    </div>
                }
                else
                {
                    <div class="pf-table-wrap">
                        <table class="pf-table">

                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Hora</th>
                                    <th>Servicio</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var cita in Citas.OrderByDescending(
                                    c => c.FechaInicio))
                                {
                                    <tr @key="cita.Id">
                                        <td>
                                            @cita.FechaInicio.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @cita.FechaInicio.ToString("HH:mm")
                                        </td>

                                        <td>
                                            Servicio #@cita.ServicioId
                                        </td>

                                        <td>
                                            <span class="pf-status @ClaseEstado(cita.Estado)">
                                                @cita.Estado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                }

            </section>
        }
        
        else if (SeccionActual == "historia")
        {
            <div class="pf-pacientes">

                <div class="pf-detail-heading">
                    <div>
                        <h2>Historia clínica</h2>

                        <p class="pf-detail-muted">
                            Consulta las atenciones, tratamientos
                            y antecedentes del paciente.
                        </p>
                    </div>
                </div>

                <nav class="pf-profile-tabs"
                     aria-label="Secciones de historia clínica">

                    <a href="@RutaClinica("atenciones")"
                       class="@(SubseccionClinica == "atenciones" ? "active" : "")"
                       aria-current="@(SubseccionClinica == "atenciones" ? "page" : null)">
                        Atenciones clínicas
                    </a>

                    <a href="@RutaClinica("antecedentes")"
                       class="@(SubseccionClinica == "antecedentes" ? "active" : "")"
                       aria-current="@(SubseccionClinica == "antecedentes" ? "page" : null)">
                        Antecedentes
                    </a>

                </nav>

                @if (SubseccionClinica == "atenciones")
                {
                    <AtencionesPanel
                        @key="Id"
                        PacienteId="@Id" />
                }
                else
                {
                    <AntecedentesPanel
                        @key="Id"
                        PacienteId="@Id"
                        PacienteActivo="@Paciente.Estatus" />
                }

            </div>
        }

        else if (SeccionActual == "pagos")
        {
            <section class="pf-card pf-info-card">

                <div class="pf-detail-heading">
                    <div>
                        <h2>Prestaciones y pagos</h2>

                        <p class="pf-detail-muted">
                            Servicios prestados y estado administrativo.
                        </p>
                    </div>

                    <button type="button"
                            class="pf-btn pf-btn-neutral"
                            disabled="@CargandoPrestaciones"
                            @onclick="CargarPrestacionesAsync">
                        Actualizar
                    </button>
                </div>

                @if (CargandoPrestaciones)
                {
                    <div class="pf-detail-empty">
                        Cargando prestaciones...
                    </div>
                }
                else if (ErrorPrestaciones is not null)
                {
                    <p class="pf-detail-error">
                        @ErrorPrestaciones
                    </p>
                }
                else if (Prestaciones.Count == 0)
                {
                    <div class="pf-detail-empty">
                        No hay prestaciones registradas.
                    </div>
                }
                else
                {
                    <div class="pf-table-wrap">
                        <table class="pf-table">

                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Prestación</th>
                                    <th>Total</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var prestacion in Prestaciones
                                    .OrderByDescending(x => x.FechaPrestacion))
                                {
                                    <tr @key="prestacion.Id">

                                        <td>
                                            @prestacion.FechaPrestacion
                                            .ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            Prestación #@prestacion.Id
                                        </td>

                                        <td>
                                            @prestacion.Total.ToString("C2", Cultura)
                                        </td>

                                        <td>
                                            <span class="pf-status @ClaseEstado(prestacion.Estado)">
                                                @prestacion.Estado
                                            </span>
                                        </td>

                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                }

                <p class="pf-detail-muted">
                    El detalle de cobros y saldos
                    se integrará posteriormente.
                </p>

            </section>
        }
    }

</div>

@code {

    [Parameter]
    public long Id { get; set; }

    [SupplyParameterFromQuery(Name = "seccion")]
    public string? Seccion { get; set; }

    [SupplyParameterFromQuery(Name = "clinica")]
    public string? Clinica { get; set; }

    private string SubseccionClinica =>
        Clinica?.Trim().ToLowerInvariant() == "antecedentes"
            ? "antecedentes"
            : "atenciones";

    private string RutaClinica(string subseccion) =>
        $"/pacientes/{Id}?seccion=historia&clinica={subseccion}";


    private PacienteDto? Paciente;

    private List<ContactoPacienteDto> Contactos = new();
    private List<CitaPacienteDto> Citas = new();
    private List<PrestacionPacienteDto> Prestaciones = new();

    private bool Cargando = true;
    private bool CargandoContactos;
    private bool CargandoCitas;
    private bool CargandoPrestaciones;

    private bool ContactosConsultados;
    private bool CitasConsultadas;
    private bool PrestacionesConsultadas;

    private string? ErrorPaciente;
    private string? ErrorContactos;
    private string? ErrorCitas;
    private string? ErrorPrestaciones;

    private readonly System.Globalization.CultureInfo Cultura =
        System.Globalization.CultureInfo.GetCultureInfo("es-EC");

    // ============================================
    // ESTADO DEL PACIENTE
    // ============================================

    private bool ConfirmandoDesactivacion;
    private bool ConfirmandoReactivacion;
    private bool ProcesandoEstado;

    private string MotivoDesactivacion = "";
    private string? ErrorEstado;
    private string? MensajeEstado;

    // ============================================
    // CONTACTOS
    // ============================================

    private ContactoGuardarDto FormularioContacto = new();

    private long? ContactoEditandoId;
    private long? ContactoConfirmacionId;

    private bool GuardandoContacto;
    private bool ProcesandoContacto;

    private string? MensajeContacto;

    // ============================================
    // PESTAÑAS
    // ============================================

    private string SeccionActual =>
        Seccion?.Trim().ToLowerInvariant() switch
        {
            "contactos" => "contactos",
            "citas" => "citas",
            "historia" => "historia",
            "pagos" => "pagos",
            _ => "resumen"
        };

    private string Ruta(string seccion) =>
        $"/pacientes/{Id}?seccion={seccion}";

    private string ClasePestana(string seccion) =>
        SeccionActual == seccion ? "active" : "";

    private string Iniciales
    {
        get
        {
            if (Paciente is null)
                return "PF";

            string nombre = Paciente.Nombres ?? "";
            string apellido = Paciente.Apellidos ?? "";

            char primera = string.IsNullOrWhiteSpace(nombre)
                ? '?'
                : nombre.Trim()[0];

            char segunda = string.IsNullOrWhiteSpace(apellido)
                ? ' '
                : apellido.Trim()[0];

            return $"{primera}{segunda}".Trim().ToUpperInvariant();
        }
    }

    private CitaPacienteDto? UltimaCita =>
        Citas.OrderByDescending(x => x.FechaInicio).FirstOrDefault();

    // ============================================
    // CARGA INICIAL
    // ============================================

    protected override async Task OnParametersSetAsync()
    {
        if (Paciente?.Id != Id)
        {
            await CargarPacienteAsync();
        }

        if (Paciente is null)
            return;

        switch (SeccionActual)
        {
            case "resumen":
            case "citas":
                if (!CitasConsultadas && !CargandoCitas)
                    await CargarCitasAsync();
                break;

            case "contactos":
                if (!ContactosConsultados && !CargandoContactos)
                    await CargarContactosAsync();
                break;

            case "pagos":
                if (!PrestacionesConsultadas && !CargandoPrestaciones)
                    await CargarPrestacionesAsync();
                break;
        }
    }

    private async Task CargarPacienteAsync()
    {
        Cargando = true;
        ErrorPaciente = null;

        Paciente = null;

        Contactos.Clear();
        Citas.Clear();
        Prestaciones.Clear();

        ContactosConsultados = false;
        CitasConsultadas = false;
        PrestacionesConsultadas = false;

        CancelarCambioEstado();
        CancelarEdicionContacto();
        CancelarCambioContacto();

        try
        {
            Paciente = await Api.ObtenerAsync(Id);

            if (Paciente is null)
                ErrorPaciente = "El paciente solicitado no existe.";
        }
        catch (InvalidOperationException ex)
        {
            ErrorPaciente = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error al cargar paciente {PacienteId}",
                Id);

            ErrorPaciente =
                "No se pudo consultar la información del paciente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task RecargarPacienteAsync()
    {
        await CargarPacienteAsync();
    }

