@page "/pacientes/nuevo"
@page "/pacientes/{Id:long}/editar"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using PodoFlow.Web.Modelos.Pacientes
@using PodoFlow.Web.Servicios

@inject IPacientesApi Api
@inject NavigationManager Nav
@inject ILogger<PacienteFormulario> Logger

<PageTitle>
    @(EsEdicion ? "Editar paciente" : "Nuevo paciente") | PodoFlow
</PageTitle>

<div class="pf-pacientes pf-form-page">

    <a class="pf-back-link" href="@RutaVolver">
        ← Volver
    </a>

    <div class="pf-module-header">
        <div>
            <span class="pf-module-eyebrow">
                GESTIÓN CLÍNICA
            </span>

            <h1>
                @(EsEdicion ? "Editar paciente" : "Nuevo paciente")
            </h1>

            <p>
                @(EsEdicion
                    ? "Actualiza la información personal del paciente."
                    : "Registra un nuevo paciente en el Centro Podológico TODO PIE.")
            </p>
        </div>
    </div>

    @if (Cargando)
    {
        <section class="pf-card pf-info-card">
            <div class="pf-empty" role="status">
                <p>Cargando información del paciente...</p>
            </div>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorCarga))
    {
        <section class="pf-card pf-info-card">
            <div class="pf-detail-error" role="alert">
                @ErrorCarga
            </div>

            <div class="pf-form-actions">
                <a href="@RutaVolver"
                   class="pf-btn pf-btn-neutral">
                    Volver
                </a>

                <button type="button"
                        class="pf-btn pf-btn-main"
                        @onclick="CargarFormularioAsync">
                    Reintentar
                </button>
            </div>
        </section>
    }
    else
    {
        <section class="pf-card pf-info-card">

            <div class="pf-form-heading">
                <div class="pf-form-mark">
                    PF
                </div>

                <div>
                    <h2>Información personal</h2>

                    <p>
                        Los campos marcados con * son obligatorios.
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorGuardar))
            {
                <div class="pf-detail-error" role="alert">
                    @ErrorGuardar
                </div>
            }

            <EditForm Model="@Modelo"
                      OnValidSubmit="@GuardarAsync"
                      FormName="form-paciente">

                <DataAnnotationsValidator />

                <div class="pf-patient-form-grid">

                    <div class="pf-form-group">

                        <label for="tipoIdentificacion">
                            Tipo de identificación *
                        </label>

                        <InputSelect id="tipoIdentificacion"
                                     class="pf-field"
                                     @bind-Value="Modelo.TipoIdentificacion"
                                     disabled="@Guardando">

                            <option value="CEDULA">Cédula</option>
                            <option value="PASAPORTE">Pasaporte</option>
                            <option value="RUC">RUC</option>
                            <option value="OTRO">Otro</option>

                        </InputSelect>

                        <ValidationMessage For="@(() => Modelo.TipoIdentificacion)" />

                    </div>

                    <div class="pf-form-group">

                        <label for="identificacion">
                            Número de identificación *
                        </label>

                        <InputText id="identificacion"
                                   class="pf-field"
                                   maxlength="30"
                                   placeholder="Ingresa la identificación"
                                   autocomplete="off"
                                   @bind-Value="Modelo.Identificacion"
                                   disabled="@Guardando" />

                        <ValidationMessage For="@(() => Modelo.Identificacion)" />

                    </div>

                    <div class="pf-form-group">

                        <label for="nombres">
                            Nombres *
                        </label>

                        <InputText id="nombres"
                                   class="pf-field"
                                   maxlength="100"
                                   placeholder="Nombres del paciente"
                                   autocomplete="off"
                                   @bind-Value="Modelo.Nombres"
                                   disabled="@Guardando" />

                        <ValidationMessage For="@(() => Modelo.Nombres)" />

                    </div>

                    <div class="pf-form-group">

                        <label for="apellidos">
                            Apellidos *
                        </label>

                        <InputText id="apellidos"
                                   class="pf-field"
                                   maxlength="100"
                                   placeholder="Apellidos del paciente"
                                   autocomplete="off"
                                   @bind-Value="Modelo.Apellidos"
                                   disabled="@Guardando" />

                        <ValidationMessage For="@(() => Modelo.Apellidos)" />

                    </div>

                    <div class="pf-form-group">

                        <label for="fechaNacimiento">
                            Fecha de nacimiento
                        </label>

                        <InputDate id="fechaNacimiento"
                                   class="pf-field"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   @bind-Value="Modelo.FechaNacimiento"
                                   disabled="@Guardando" />

                        <ValidationMessage For="@(() => Modelo.FechaNacimiento)" />

                    </div>

                    <div class="pf-form-group">

                        <label for="genero">
                            Género
                        </label>

                        <InputSelect id="genero"
                                     class="pf-field"
                                     @bind-Value="Modelo.Genero"
                                     disabled="@Guardando">

                            <option value="">No especificado</option>
                            <option value="FEMENINO">Femenino</option>
                            <option value="MASCULINO">Masculino</option>
                            <option value="OTRO">Otro</option>

                        </InputSelect>

                        <ValidationMessage For="@(() => Modelo.Genero)" />

                    </div>

                    <div class="pf-form-group pf-form-full">

                        <label for="direccion">
                            Dirección
                        </label>

                        <InputText id="direccion"
                                   class="pf-field"
                                   maxlength="300"
                                   placeholder="Dirección del paciente (opcional)"
                                   autocomplete="off"
                                   @bind-Value="Modelo.Direccion"
                                   disabled="@Guardando" />

                        <ValidationMessage For="@(() => Modelo.Direccion)" />

                    </div>

                </div>

                <div class="pf-form-actions">

                    <a href="@RutaVolver"
                       class="pf-btn pf-btn-neutral">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="pf-btn pf-btn-main"
                            disabled="@Guardando">

                        @if (Guardando)
                        {
                            <span>Guardando...</span>
                        }
                        else if (EsEdicion)
                        {
                            <span>Guardar cambios</span>
                        }
                        else
                        {
                            <span>Registrar paciente</span>
                        }

                    </button>

                </div>

            </EditForm>

        </section>
    }

</div>

@code {

    [Parameter]
    public long? Id { get; set; }

    // ============================================
    // ESTADO DEL FORMULARIO
    // ============================================

    private PacienteGuardarDto Modelo = new();

    private bool Cargando;

    private bool Guardando;

    private string? ErrorCarga;

    private string? ErrorGuardar;

    private bool EsEdicion => Id.HasValue;

    private string RutaVolver =>
        Id.HasValue
            ? $"/pacientes/{Id.Value}"
            : "/pacientes";

    // ============================================
    // INICIALIZACIÓN
    // ============================================

    protected override async Task OnParametersSetAsync()
    {
        await CargarFormularioAsync();
    }

    // ============================================
    // CARGAR FORMULARIO
    // ============================================

    private async Task CargarFormularioAsync()
    {
        ErrorCarga = null;
        ErrorGuardar = null;

        if (!EsEdicion)
        {
            Modelo = new PacienteGuardarDto();
            Cargando = false;
            return;
        }

        Cargando = true;

        try
        {
            var paciente = await Api.ObtenerAsync(Id!.Value);

            if (paciente is null)
            {
                ErrorCarga = "No se encontró el paciente solicitado.";
                return;
            }

            if (!paciente.Estatus)
            {
                ErrorCarga =
                    "Este paciente se encuentra inactivo. " +
                    "Para editarlo, primero debes reactivarlo " +
                    "desde su ficha.";
                return;
            }

            Modelo = PacienteGuardarDto.Desde(paciente);
        }
        catch (InvalidOperationException ex)
        {
            ErrorCarga = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error al cargar el paciente {PacienteId}",
                Id);

            ErrorCarga =
                "No se pudo cargar la información del paciente. " +
                "Comprueba la conexión e intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    // ============================================
    // GUARDAR PACIENTE
    // ============================================

    private async Task GuardarAsync()
    {
        if (Guardando || Cargando)
            return;

        Guardando = true;

        ErrorGuardar = null;

        try
        {
            // El servicio normaliza y valida el DTO
            // antes de enviarlo al backend.

            if (EsEdicion)
            {
                await ActualizarPacienteAsync();
            }
            else
            {
                await CrearPacienteAsync();
            }
        }
        catch (InvalidOperationException ex)
        {
            ErrorGuardar = ex.Message;
        }
        catch (ArgumentException ex)
        {
            ErrorGuardar = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error al guardar paciente. Id: {PacienteId}",
                Id);

            ErrorGuardar =
                "No fue posible completar la operación. " +
                "Si estabas registrando un paciente, " +
                "comprueba primero si aparece en el directorio " +
                "antes de intentarlo nuevamente.";
        }
        finally
        {
            Guardando = false;
        }
    }

    // ============================================
    // CREAR PACIENTE
    // ============================================

    private async Task CrearPacienteAsync()
    {
        var pacienteCreado = await Api.CrearAsync(Modelo);

        Logger.LogInformation(
            "Paciente registrado correctamente. Id: {PacienteId}",
            pacienteCreado.Id);

        Nav.NavigateTo(
            $"/pacientes/{pacienteCreado.Id}");
    }

    // ============================================
    // ACTUALIZAR PACIENTE
    // ============================================

    private async Task ActualizarPacienteAsync()
    {
        if (!Id.HasValue)
        {
            throw new InvalidOperationException(
                "No se encontró el identificador del paciente.");
        }

        if (string.IsNullOrWhiteSpace(Modelo.Version))
        {
            throw new InvalidOperationException(
                "No se encontró la versión del registro. " +
                "Vuelve a cargar el paciente antes de editarlo.");
        }

        await Api.ActualizarAsync(
            Id.Value,
            Modelo);

        Logger.LogInformation(
            "Paciente actualizado correctamente. Id: {PacienteId}",
            Id.Value);

        Nav.NavigateTo(
            $"/pacientes/{Id.Value}");
    }
}

