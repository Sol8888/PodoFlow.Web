@page "/privacidad/incidentes"
@rendermode InteractiveServer

@inject IPrivacidadApi Api
@inject NavigationManager Navegacion

<PageTitle>Incidentes de seguridad | PodoFlow</PageTitle>

<div class="pf-pacientes">

    <div class="pf-module-header">
        <div>
            <span class="pf-module-eyebrow">PRIVACIDAD Y LOPDP</span>
            <h1>Incidentes de seguridad</h1>
            <p>Vulneraciones o sospechas que afectan datos personales, con su bitácora desde la detección hasta el cierre.</p>
        </div>
    </div>

    <PrivacidadPestanas Activa="incidentes" />

    @if (Error != null)
    {
        <div class="pf-detail-error" role="alert">@Error</div>
    }

    @if (!Cargando && Abiertos > 0)
    {
        <p class="pf-detail-muted resumen">
            @(Abiertos == 1 ? "1 incidente sigue abierto" : $"{Abiertos} incidentes siguen abiertos") (sin cerrar).
        </p>
    }

    <div class="pf-module-toolbar">
        <select class="pf-field filtro" aria-label="Filtrar por estado" @bind="FiltroEstado">
            <option value="">Todos los estados</option>
            <option value="PENDIENTES">Sin cerrar</option>
            @foreach (var estado in IncidenteDto.NombresEstado)
            {
                <option value="@estado.Key">@estado.Value</option>
            }
        </select>

        <button type="button" class="pf-btn pf-btn-main boton-derecha" disabled="@Procesando" @onclick="Nuevo">
            Registrar incidente
        </button>
    </div>

    @if (Formulario != null)
    {
        <section class="pf-card pf-info-card">
            <h2>Registrar incidente</h2>
            <p class="pf-detail-muted">Queda en estado Abierto y se anota en la bitácora. La hora es la de Ecuador.</p>

            <IncidenteCampos Formulario="Formulario" Prefijo="nuevo" />

            @if (ErrorFormulario != null)
            {
                <div class="pf-detail-error" role="alert">@ErrorFormulario</div>
            }

            <div class="pf-form-actions">
                <button type="button" class="pf-btn pf-btn-neutral" @onclick="CerrarFormulario">Cancelar</button>

                <button type="button" class="pf-btn pf-btn-main" disabled="@Procesando" @onclick="GuardarAsync">
                    @(Procesando ? "Guardando..." : "Registrar")
                </button>
            </div>
        </section>
    }

    <section class="pf-card pf-directory">
        <div class="pf-card-header">
            <div>
                <h2>Incidentes registrados</h2>
                <p>Del detectado más recientemente al más antiguo.</p>
            </div>

            <span class="pf-soft-chip">@(Visibles.Count() == 1 ? "1 visible" : $"{Visibles.Count()} visibles")</span>
        </div>

        @if (Cargando)
        {
            <div class="pf-empty" role="status">Cargando incidentes...</div>
        }
        else if (!Visibles.Any())
        {
            <div class="pf-empty">No hay incidentes con este filtro.</div>
        }
        else
        {
            <div class="pf-table-wrap">
                <table class="pf-table">
                    <thead>
                        <tr>
                            <th>Incidente</th>
                            <th>Detectado</th>
                            <th>Módulo</th>
                            <th>Estado</th>
                            <th>Acción</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var incidente in Visibles)
                        {
                            <tr @key="incidente.Id">
                                <td>
                                    <strong>@incidente.Tipo</strong>
                                    <small class="pf-detail-muted detalle">#@incidente.Id · @Recortar(incidente.Descripcion)</small>
                                </td>
                                <td>
                                    @FechaHora(incidente.FechaDeteccion)
                                    @if (!incidente.EsCerrado)
                                    {
                                        <small class="pf-detail-muted detalle">@Antiguedad(incidente.FechaDeteccion)</small>
                                    }
                                </td>
                                <td>@incidente.Modulo</td>
                                <td>
                                    <span class="@IncidenteDto.ClaseEstado(incidente.Estado)">@IncidenteDto.NombreEstado(incidente.Estado)</span>
                                    @if (incidente.FechaCierre.HasValue)
                                    {
                                        <small class="pf-detail-muted detalle">el @FechaHora(incidente.FechaCierre.Value)</small>
                                    }
                                </td>
                                <td>
                                    <a class="pf-contact-action enlace" href="@($"/privacidad/incidentes/{incidente.Id}")">Abrir</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

</div>

@code {
    private List<IncidenteDto> Lista = new();
    private IncidenteGuardarDto? Formulario;
    private string FiltroEstado = "";

    private bool Cargando = true;
    private bool Procesando;
    private string? Error;
    private string? ErrorFormulario;

    private int Abiertos => Lista.Count(i => !i.EsCerrado);

    private IEnumerable<IncidenteDto> Visibles => Lista
        .Where(i => FiltroEstado == ""
            || (FiltroEstado == "PENDIENTES" && !i.EsCerrado)
            || i.Estado == FiltroEstado)
        .OrderByDescending(i => i.FechaDeteccion)
        .ThenByDescending(i => i.Id);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Lista = await Api.ListarIncidentesAsync();
        }
        catch (InvalidOperationException ex)
        {
            Error = ex.Message;
        }
        catch (HttpRequestException)
        {
            Error = "No fue posible conectar con PodoFlow.Api.";
        }
        catch (TaskCanceledException)
        {
            Error = "La API tardó demasiado en responder. Recarga la página.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private static string Recortar(string texto) => texto.Length <= 90 ? texto : texto[..90] + "…";

    private static string FechaHora(DateTime fecha) => PrivacidadApi.HoraEcuador(fecha).ToString("dd/MM/yyyy HH:mm");

    private static string Antiguedad(DateTime deteccion)
    {
        var tiempo = DateTime.UtcNow - DateTime.SpecifyKind(deteccion, DateTimeKind.Utc);

        if (tiempo.TotalHours < 1)
            return "hace menos de una hora";

        if (tiempo.TotalDays < 1)
            return $"hace {(int)tiempo.TotalHours} h";

        return (int)tiempo.TotalDays == 1 ? "hace 1 día" : $"hace {(int)tiempo.TotalDays} días";
    }

    private static DateTime AhoraEcuador()
    {
        var ahora = PrivacidadApi.HoraEcuador(DateTime.UtcNow);
        return new DateTime(ahora.Year, ahora.Month, ahora.Day, ahora.Hour, ahora.Minute, 0);
    }

    private void Nuevo()
    {
        Formulario = new IncidenteGuardarDto { FechaDeteccion = AhoraEcuador(), Modulo = "GENERAL" };
        ErrorFormulario = null;
        Error = null;
    }

    private void CerrarFormulario()
    {
        Formulario = null;
        ErrorFormulario = null;
    }

    private async Task GuardarAsync()
    {
        if (Procesando || Formulario == null)
            return;

        ErrorFormulario = Formulario.Validar(PrivacidadApi.HoraEcuador(DateTime.UtcNow));

        if (ErrorFormulario != null)
            return;

        Procesando = true;

        try
        {
            var creado = await Api.CrearIncidenteAsync(Formulario);
            Navegacion.NavigateTo($"/privacidad/incidentes/{creado.Id}?nuevo=1");
        }
        catch (InvalidOperationException ex)
        {
            ErrorFormulario = ex.Message;
        }
        catch (HttpRequestException)
        {
            ErrorFormulario = "No fue posible conectar con PodoFlow.Api.";
        }
        catch (TaskCanceledException)
        {
            ErrorFormulario = "La operación tardó demasiado. Recarga la página para ver si se guardó.";
        }
        finally
        {
            Procesando = false;
        }
    }
}
