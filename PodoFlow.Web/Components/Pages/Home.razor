@page "/"
@attribute [StreamRendering]
@using System.Globalization
@using PodoFlow.Web.Modelos.Citas
@using PodoFlow.Web.Modelos.Inventario
@using PodoFlow.Web.Modelos.Pagos

@inject IAgendaApi Agenda
@inject IInventarioApi Inventario
@inject IPagosApi Pagos
@inject ILogger<Home> Logger

<PageTitle>Dashboard | PodoFlow</PageTitle>

<div class="pf-dashboard">

    <section class="pf-hero">
        <div class="pf-hero-left">
            <span class="pf-badge">Dashboard principal</span>
            <h1>Bienvenida de vuelta</h1>
            <p>
                Tienes un resumen rápido de la actividad del consultorio:
                citas de hoy, pagos, inventario y seguimiento de la jornada.
            </p>

            <div class="pf-hero-actions">
                <a class="pf-btn pf-btn-primary" href="/citas">Ver citas de hoy</a>
                <a class="pf-btn pf-btn-secondary" href="/citas/listado">Registrar nueva cita</a>
            </div>

            @if (Avisos.Count > 0)
            {
                <p class="pf-detail-muted" role="status">No se pudo cargar: @string.Join(", ", Avisos).</p>
            }
        </div>

        <div class="pf-hero-right">
            <div class="pf-hero-metric">
                <span class="pf-hero-number">@CitasHoy.Count</span>
                <small>Citas programadas hoy</small>
            </div>
        </div>
    </section>

    <section class="pf-kpi-grid">
        <div class="pf-kpi-card">
            <div class="pf-kpi-header">
                <span>Citas de hoy</span>
                <div class="pf-kpi-icon blue"></div>
            </div>
            <strong>@CitasHoy.Count</strong>
            <p>@CitasHoy.Count(c => c.Estado == "CONFIRMADA") confirmadas para hoy</p>
        </div>

        <div class="pf-kpi-card">
            <div class="pf-kpi-header">
                <span>Pacientes atendidos</span>
                <div class="pf-kpi-icon green"></div>
            </div>
            <strong>@CitasHoy.Count(c => c.Estado == "ATENDIDA")</strong>
            <p>Atenciones registradas en la jornada</p>
        </div>

        <div class="pf-kpi-card">
            <div class="pf-kpi-header">
                <span>Cobrado hoy</span>
                <div class="pf-kpi-icon orange"></div>
            </div>
            <strong>@CobradoHoy.ToString("C2", Cultura)</strong>
            <p>@PrestacionesPendientes pendientes de cobro</p>
        </div>

        <div class="pf-kpi-card">
            <div class="pf-kpi-header">
                <span>Inventario</span>
                <div class="pf-kpi-icon red"></div>
            </div>
            <strong>@InsumosBajos.Count</strong>
            <p>Insumos por debajo del mínimo</p>
        </div>
    </section>

    <section class="pf-content-grid">

        <div class="pf-left-column">

            <div class="pf-card">
                <div class="pf-card-header">
                    <div>
                        <h2>Citas de hoy</h2>
                        <p>Pacientes programados para la jornada</p>
                    </div>
                    <span class="pf-soft-chip">@CitasHoy.Count citas</span>
                </div>

                <div class="pf-table-wrap">
                    <table class="pf-table">
                        <thead>
                            <tr>
                                <th>Hora</th>
                                <th>Paciente</th>
                                <th>Servicio</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Cargando)
                            {
                                <tr><td colspan="5">Cargando citas...</td></tr>
                            }
                            else if (CitasHoy.Count == 0)
                            {
                                <tr><td colspan="5">No hay citas programadas para hoy.</td></tr>
                            }
                            @foreach (var cita in CitasHoy)
                            {
                                <tr>
                                    <td class="pf-time">@cita.Hora</td>
                                    <td>
                                        <div class="pf-patient">
                                            <div class="pf-patient-avatar">@cita.Iniciales</div>
                                            <span>@cita.Paciente</span>
                                        </div>
                                    </td>
                                    <td>@cita.Servicio</td>
                                    <td>
                                        <span class="pf-status @GetStatusClass(cita.Estado)">
                                            @cita.Estado
                                        </span>
                                    </td>
                                    <td>
                                        @if (AgendaReglas.PuedeAtenderse(cita.Estado, cita.Inicio, cita.Fin))
                                        {
                                            <a class="pf-btn pf-btn-main" href="@($"/citas/{cita.Id}/atender")">Atender</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="pf-bottom-row">
                <div class="pf-card">
                    <div class="pf-card-header">
                        <div>
                            <h2>Inventario crítico</h2>
                            <p>Insumos que necesitan atención</p>
                        </div>
                    </div>

                    <div class="pf-list">
                        @if (!Cargando && InsumosBajos.Count == 0)
                        {
                            <div class="pf-list-item">
                                <div class="pf-list-bullet green"></div>
                                <div class="pf-list-content">
                                    <strong>Todo en orden</strong>
                                    <span>Ningún insumo está por debajo del mínimo.</span>
                                </div>
                            </div>
                        }
                        @foreach (var insumo in InsumosBajos)
                        {
                            <div class="pf-list-item">
                                <div class="pf-list-bullet orange"></div>
                                <div class="pf-list-content">
                                    <strong>@insumo.Nombre</strong>
                                    <span>Disponible: @Numero(insumo.StockActual) @insumo.Unidad</span>
                                </div>
                                <span class="pf-mini-chip warning">Mínimo @Numero(insumo.StockMinimo)</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="pf-card">
                    <div class="pf-card-header">
                        <div>
                            <h2>Pagos</h2>
                            <p>Estado general del día</p>
                        </div>
                    </div>

                    <div class="pf-payment-box">
                        <div class="pf-payment-total">
                            <span>Total cobrado</span>
                            <strong>@CobradoHoy.ToString("C2", Cultura)</strong>
                        </div>

                        <div class="pf-payment-item">
                            <span>Prestaciones pagadas hoy</span>
                            <strong>@PrestacionesPagadasHoy</strong>
                        </div>

                        <div class="pf-payment-item">
                            <span>Prestaciones pendientes</span>
                            <strong>@PrestacionesPendientes</strong>
                        </div>

                        <div class="pf-payment-item">
                            <span>Saldo pendiente</span>
                            <strong>@SaldoPendiente.ToString("C2", Cultura)</strong>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="pf-right-column">

            <div class="pf-card pf-agenda-card">
                <div class="pf-card-header">
                    <div>
                        <h2>Agenda rápida</h2>
                        <p>@FechaActual</p>
                    </div>
                </div>

                <div class="pf-agenda-list">
                    @if (!Cargando && CitasHoy.Count == 0)
                    {
                        <p class="pf-detail-muted">Sin citas para hoy.</p>
                    }
                    @foreach (var cita in CitasHoy)
                    {
                        <div class="pf-agenda-item">
                            <div class="pf-agenda-avatar">@cita.Iniciales</div>
                            <div class="pf-agenda-info">
                                <strong>@cita.Paciente</strong>
                                <span>@cita.Hora · @cita.Servicio</span>
                            </div>
                            <div class="pf-agenda-status @GetStatusClass(cita.Estado)">
                                @cita.Estado
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="pf-card">
                <div class="pf-card-header">
                    <div>
                        <h2>Resumen del día</h2>
                        <p>Seguimiento rápido</p>
                    </div>
                </div>

                <div class="pf-summary-list">
                    <div class="pf-summary-row">
                        <div class="pf-summary-indicator blue"></div>
                        <div>
                            <strong>@CitasHoy.Count citas</strong>
                            <span>Agendadas para hoy</span>
                        </div>
                    </div>

                    <div class="pf-summary-row">
                        <div class="pf-summary-indicator green"></div>
                        <div>
                            <strong>@CitasHoy.Count(c => c.Estado == "ATENDIDA") atenciones</strong>
                            <span>Marcadas como atendidas</span>
                        </div>
                    </div>

                    <div class="pf-summary-row">
                        <div class="pf-summary-indicator orange"></div>
                        <div>
                            <strong>@PrestacionesPendientes prestaciones</strong>
                            <span>Pendientes de cobro</span>
                        </div>
                    </div>

                    <div class="pf-summary-row">
                        <div class="pf-summary-indicator red"></div>
                        <div>
                            <strong>@InsumosBajos.Count alertas</strong>
                            <span>Inventario bajo el mínimo</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </section>

</div>

@code {
    private readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-EC");

    private static DateTime Hoy => AgendaFechas.Ahora.Date;

    private string FechaActual =>
        Hoy.ToString("dddd, dd 'de' MMMM 'de' yyyy", Cultura);

    private bool Cargando = true;
    private readonly List<string> Avisos = [];

    private List<CitaHoy> CitasHoy = [];
    private List<InsumoDto> InsumosBajos = [];

    private decimal CobradoHoy;
    private int PrestacionesPendientes;
    private int PrestacionesPagadasHoy;
    private decimal SaldoPendiente;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarCitasAsync(), CargarInventarioAsync(), CargarPagosAsync());
        Cargando = false;
    }

    private async Task CargarCitasAsync()
    {
        try
        {
            var catalogos = Agenda.CargarCatalogosAsync();
            var citas = Agenda.CitasEntreAsync(Hoy, Hoy.AddDays(1));

            await Task.WhenAll(catalogos, citas);

            var nombres = await catalogos;

            CitasHoy = (await citas)
                .Where(x => x.Estado != "CANCELADA")
                .OrderBy(x => x.InicioLocal)
                .Select(x => new CitaHoy(
                    x.Id,
                    x.InicioLocal,
                    x.FinLocal,
                    x.InicioLocal.ToString("HH:mm"),
                    nombres.NombrePaciente(x.PacienteId),
                    Iniciales(nombres.NombrePaciente(x.PacienteId)),
                    nombres.NombreServicio(x.ServicioId),
                    x.Estado))
                .ToList();
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "No se pudieron cargar las citas del dashboard");
            Avisos.Add("citas");
        }
    }

    private async Task CargarInventarioAsync()
    {
        try
        {
            InsumosBajos = (await Inventario.ListarInsumosAsync())
                .Where(x => x.Estatus && x.BajoMinimo)
                .OrderBy(x => x.StockActual - x.StockMinimo)
                .Take(6)
                .ToList();
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "No se pudo cargar el inventario del dashboard");
            Avisos.Add("inventario");
        }
    }

    private async Task CargarPagosAsync()
    {
        try
        {
            var pendientesTarea = Pagos.ListarPrestacionesAsync(null, "PENDIENTE");
            var cobrosTarea = Pagos.ListarCobrosAsync(null);

            await Task.WhenAll(pendientesTarea, cobrosTarea);

            var pendientes = await pendientesTarea;
            var cobros = (await cobrosTarea).Where(x => x.Estado == "REGISTRADO").ToList();
            var cobrosHoy = cobros.Where(x => AgendaFechas.ALocal(x.FechaPago).Date == Hoy).ToList();
            var idsPendientes = pendientes.Select(x => x.Id).ToHashSet();

            PrestacionesPendientes = pendientes.Count;
            SaldoPendiente = pendientes.Sum(x => x.Total) -
                             cobros.Where(x => idsPendientes.Contains(x.PrestacionId)).Sum(x => x.Valor);
            CobradoHoy = cobrosHoy.Sum(x => x.Valor);
            PrestacionesPagadasHoy = cobrosHoy
                .Where(x => x.EstadoPrestacion == "PAGADA")
                .Select(x => x.PrestacionId)
                .Distinct()
                .Count();
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "No se pudieron cargar los pagos del dashboard");
            Avisos.Add("pagos");
        }
    }

    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return partes.Length switch
        {
            0 => "?",
            1 => partes[0][..1].ToUpperInvariant(),
            _ => (partes[0][..1] + partes[^1][..1]).ToUpperInvariant()
        };
    }

    private string Numero(decimal valor) => valor.ToString("0.##", Cultura);

    private static string GetStatusClass(string estado) => estado switch
    {
        "ATENDIDA" => "success",
        "CONFIRMADA" => "info",
        "SOLICITADA" or "REPROGRAMADA" => "warning",
        "CANCELADA" or "NO_ASISTE" => "danger",
        _ => ""
    };

    private sealed record CitaHoy(long Id, DateTime Inicio, DateTime Fin, string Hora, string Paciente, string Iniciales, string Servicio, string Estado);
}