@inject IWebHostEnvironment Entorno

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="@UrlConVersion("app.css")" />
    <link rel="stylesheet" href="@UrlConVersion("tema.css")" />
    <link rel="stylesheet" href="@UrlConVersion("PodoFlow.Web.styles.css")" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        document.addEventListener("click", function (e) {
            if (e.target.closest(".pf-nav a")) {
                var menu = document.getElementById("pf-menu");
                if (menu) menu.checked = false;
            }
        });
    </script>
</body>

</html>
@code {
    // La versión cambia con cada modificación, así el navegador no usa una hoja vieja de su caché.
    private string UrlConVersion(string ruta)
    {
        var archivo = Entorno.WebRootFileProvider.GetFileInfo(ruta);

        var version = archivo.Exists
            ? archivo.LastModified.ToUnixTimeMilliseconds()
            : 0;

        return $"/{ruta}?v={version}";
    }
}