@inject IWebHostEnvironment Entorno

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="@UrlAppCss" />
    <link rel="stylesheet" href="tema.css" />
    <link rel="stylesheet" href="PodoFlow.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
@code {
    private string UrlAppCss
    {
        get
        {
            var archivo = Entorno.WebRootFileProvider
                .GetFileInfo("app.css");

            var version = archivo.Exists
                ? archivo.LastModified.ToUnixTimeMilliseconds()
                : 0;
            return $"/app.css?v={version}";
        }
    }
}